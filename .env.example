NODE_ENV=development
PORT=3000
APP_NAME=GachiSallim Backend
APP_VERSION=0.1.0
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gachisallim?schema=public
AWS_REGION=ap-northeast-2
COGNITO_USER_POOL_ID=ap-northeast-2_example
COGNITO_CLIENT_ID=exampleclientid
NOTIFICATION_PUSH_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/123456789012/gachisallim-development-notification-push
NOTIFICATION_PUSH_RESULT_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/123456789012/gachisallim-development-notification-push-result
NOTIFICATION_VAPID_PUBLIC_KEY=BExampleUrlSafeBase64PublicKey
NOTIFICATION_OUTBOX_POLL_INTERVAL_MS=5000
NOTIFICATION_OUTBOX_BATCH_SIZE=10
NOTIFICATION_OUTBOX_MAX_ATTEMPTS=10
NOTIFICATION_RESULT_POLL_INTERVAL_MS=5000
NOTIFICATION_COMMAND_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/123456789012/gachisallim-development-notification-command
NOTIFICATION_COMMAND_QUEUE_ARN=arn:aws:sqs:ap-northeast-2:123456789012:gachisallim-development-notification-command
NOTIFICATION_COMMAND_DLQ_ARN=arn:aws:sqs:ap-northeast-2:123456789012:gachisallim-development-notification-command-dlq
CHORE_DUE_SCHEDULE_GROUP=gachisallim-development-chore-due
CHORE_DUE_SCHEDULE_ROLE_ARN=arn:aws:iam::123456789012:role/gachisallim-development-chore-due-scheduler
CHORE_DUE_SCHEDULE_PREFIX=development
CHORE_DUE_NOTIFICATION_TIME=09:00
CHORE_DUE_TIME_ZONE=Asia/Seoul
NOTIFICATION_COMMAND_POLL_INTERVAL_MS=5000

# [Expense Webhook Secret Key]
# 주의: 기본값 'gachisallim-webhook-secret-key' 사용 시 앱 기동이 차단됩니다(Fail-closed).
# 로컬 개발 시: 임의의 시크릿 문자열을 입력하세요. (예: local-secret-1234)
# 운영 배포 시: PG/핀테크사와 공유할 32자 이상의 난수 키를 입력해야 합니다.
WEBHOOK_SECRET=your-custom-webhook-secret-key