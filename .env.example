NODE_ENV=development
PORT=3000
APP_NAME=GachiSallim Backend
APP_VERSION=0.1.0
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gachisallim?schema=public
AWS_REGION=ap-northeast-2
COGNITO_USER_POOL_ID=ap-northeast-2_example
COGNITO_CLIENT_ID=exampleclientid
NOTIFICATION_PUSH_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/123456789012/gachisallim-development-notification-push
NOTIFICATION_PUSH_RESULT_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/123456789012/gachisallim-development-notification-push-result
NOTIFICATION_VAPID_PUBLIC_KEY=BExampleUrlSafeBase64PublicKey
NOTIFICATION_OUTBOX_POLL_INTERVAL_MS=5000
NOTIFICATION_OUTBOX_BATCH_SIZE=10
NOTIFICATION_OUTBOX_MAX_ATTEMPTS=10
NOTIFICATION_RESULT_POLL_INTERVAL_MS=5000
